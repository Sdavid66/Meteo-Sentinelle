            "tree_name": "Tree name",
            "crop": "Species",
            "stage": "Current phenological stage",
            "auto_advance": "Advance stage automatically (growing degree days)",
            "gdd_offset": "Degree-day offset (local calibration)"
          }
        },
        "reconfigure": {
